# SecondBrain Environment Configuration

# Google Gemini API Key - Get from https://makersuite.google.com/app/apikey
# Used for: live voice, STT/TTS, conversation, memory synthesis, knowledge
# extraction, insights, patterns, prompts, theories, and embeddings.
EXPO_PUBLIC_GEMINI_API_KEY=""

# Optional: Gemini TTS / Live API voice name (default: Kore)
# Available: Kore, Charon, Fenrir, Aoede, Puck, Leda, Orus, Zephyr
EXPO_PUBLIC_GEMINI_TTS_VOICE="Kore"

# Live API (voice). When true, voice conversations run over one streaming
# WebSocket session (audio in / audio out) instead of the 3-call STT -> LLM
# -> TTS REST pipeline. Defaults to "false" (REST pipeline) — flip to "true"
# to dogfood the Live API path. See docs/live-api-refactor.md.
EXPO_PUBLIC_USE_LIVE_API="false"
EXPO_PUBLIC_LIVE_VOICE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"

# Optional: OpenAI API Key - enables GPT-5 mini as alternative chat provider
EXPO_PUBLIC_OPENAI_API_KEY=""

# Default chat provider/model for the REST voice fallback. Conversation runs
# with thinking=minimal for lowest latency; synthesis tasks use thinking=medium
# (hard-coded in each service).
# Available providers: gemini | openai
EXPO_PUBLIC_PRIMARY_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_PRIMARY_MODEL="gemini-3.1-flash-preview"

# Per-task model overrides for async analysis (all default to gemini-3.1-flash-preview)
EXPO_PUBLIC_MEMORY_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_MEMORY_MODEL="gemini-3.1-flash-preview"

EXPO_PUBLIC_KNOWLEDGE_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_KNOWLEDGE_MODEL="gemini-3.1-flash-preview"

EXPO_PUBLIC_EMBEDDING_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_EMBEDDING_MODEL="text-embedding-004"

EXPO_PUBLIC_INSIGHTS_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_INSIGHTS_MODEL="gemini-3.1-flash-preview"

EXPO_PUBLIC_PATTERN_MODEL="gemini-3.1-flash-preview"
EXPO_PUBLIC_PROMPT_MODEL="gemini-3.1-flash-preview"
EXPO_PUBLIC_THEORY_MODEL="gemini-3.1-flash-preview"

# SecondBrain Environment Configuration

# Google Gemini API Key - Get from https://makersuite.google.com/app/apikey
# Used for: STT, TTS, conversation, memory synthesis, knowledge extraction,
# insights, patterns, prompts, theories, and embeddings.
EXPO_PUBLIC_GEMINI_API_KEY=""

# Optional: Gemini TTS voice name (default: Kore)
# Available: Kore, Charon, Fenrir, Aoede, Puck, Leda, Orus, Zephyr
EXPO_PUBLIC_GEMINI_TTS_VOICE="Kore"

# Optional: OpenAI API Key - enables GPT-5 mini as alternative chat provider
EXPO_PUBLIC_OPENAI_API_KEY=""

# Default chat provider/model. Conversation runs on Gemini 3 Flash with
# thinking=minimal for lowest latency. Synthesis tasks use the same model
# but with thinking=medium (hard-coded in each service).
# Available providers: gemini | openai
EXPO_PUBLIC_PRIMARY_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_PRIMARY_MODEL="gemini-3-flash-preview"

# Per-task model overrides (all default to gemini-3-flash-preview)
EXPO_PUBLIC_MEMORY_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_MEMORY_MODEL="gemini-3-flash-preview"

EXPO_PUBLIC_KNOWLEDGE_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_KNOWLEDGE_MODEL="gemini-3-flash-preview"

EXPO_PUBLIC_EMBEDDING_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_EMBEDDING_MODEL="text-embedding-004"

EXPO_PUBLIC_INSIGHTS_MODEL_PROVIDER="gemini"
EXPO_PUBLIC_INSIGHTS_MODEL="gemini-3-flash-preview"

EXPO_PUBLIC_PATTERN_MODEL="gemini-3-flash-preview"
EXPO_PUBLIC_PROMPT_MODEL="gemini-3-flash-preview"
EXPO_PUBLIC_THEORY_MODEL="gemini-3-flash-preview"
